# GCP: banco Firestore existente (não precisa de aplicação Firebase).
GOOGLE_CLOUD_PROJECT=vernal-citadel-309420
FIRESTORE_DATABASE_ID=preset-pedals-guitar

# Autenticação por código de e-mail. Apenas variáveis de servidor.
APP_ORIGIN=http://localhost:3000
AUTH_ALLOWED_EMAILS=
# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Serviço de envio SMTP. Os códigos não são enviados enquanto estes campos estiverem vazios.
SMTP_HOST=
SMTP_PORT=587
# false na porta 587 (STARTTLS obrigatório); true na porta 465 (TLS direto).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Endereço remetente autorizado/verificado no provedor SMTP, sem nome ou < >.
OTP_FROM_EMAIL=

GOOGLE_CLOUD_CLIENT_EMAIL=conta@vernal-citadel-309420.iam.gserviceaccount.com
GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
